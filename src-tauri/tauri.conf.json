{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cs2-editor",
  "version": "0.1.0",
  "identifier": "com.cs2editor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cs2-editor",
        "width": 800,
        "height": 600
      }
    ],
  "security": {
    "assetProtocol": {
      "enable": true,
      "scope": ["$HOME/**/*"]
    },
    "csp": "default-src 'self'; media-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost"
  }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
